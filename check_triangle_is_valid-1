# A python program to check whether a triangle is valid given its three angles
num1= float(input("enter first angle"))
num2= float(input("enter second angle"))
num3= float(input("enter third angle"))
if num1 > 0 and num2 > 0 and num3 > 0 and (num1 + num2 +num3 == 180):
    print("Triangle is valid.")
else:
    print("Triangle is not valid.")